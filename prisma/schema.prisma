generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  githubId  String   @unique @map("github_id")
  username  String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Topic {
  id         String @id @default(cuid())
  text       String
  category   String
  difficulty String

  @@map("topics")
}
