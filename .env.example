# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Supabase or Neon)
DATABASE_URL=

# GitHub OAuth App (one per environment)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Groq API (free tier LLM scoring)
GROQ_API_KEY=
