# Copy to .env and fill in real values. Never commit .env.
# (Prisma CLI only auto-loads `.env`, not `.env.local` — so `.env` is the
# single local file for both Next.js and Prisma.)

# Postgres connection string (Supabase or Neon)
DATABASE_URL=

# GitHub OAuth App (one per environment)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Groq API (free tier LLM scoring)
GROQ_API_KEY=
